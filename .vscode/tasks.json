{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: ejecutar",
      "type": "shell",
      "command": "./mvnw spring-boot:run -Dspring-boot.run.profiles=local",
      "windows": {
        "command": ". ..\\scripts\\load-env.ps1; .\\mvnw.cmd spring-boot:run '-Dspring-boot.run.profiles=local'"
      },
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": []
    },
    {
      "label": "Frontend: ejecutar",
      "type": "shell",
      "command": "npm run dev",
      "windows": {
        "command": "npm.cmd run dev"
      },
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": []
    },
    {
      "label": "Backend: pruebas completas",
      "type": "shell",
      "command": "./mvnw verify",
      "windows": {
        "command": ".\\mvnw.cmd verify"
      },
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": []
    },
    {
      "label": "Frontend: pruebas",
      "type": "shell",
      "command": "npm test",
      "windows": {
        "command": "npm.cmd test"
      },
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": []
    }
  ]
}
